    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "# Parameters\n",
    "start_date = datetime(2025, 3, 1)\n",
    "end_date = datetime(2025, 11, 30)\n",
    "num_trips_per_day = 500  # average trips dailY\n",
    "\n",
    "dates = pd.date_range(start_date, end_date)\n",
    "\n",
    "records = []\n",
    "\n",
    "for date in dates:\n",
    "    for _ in range(num_trips_per_day):\n",
    "        # Random NYC \n",
    "        pickup_lat = np.random.uniform(40.55, 40.90)# pickuplatitud\n",
    "        pickup_lon = np.random.uniform(-74.05, -73.70)# pickup longitued\n",
    "        dropoff_lat = np.random.uniform(40.55, 40.90)# dropp off longitude\n",
    "        dropoff_lon = np.random.uniform(-74.05, -73.70)# drop off latitude\n",
    "        \n",
    "        # Trip distance in km\n",
    "        distance = np.random.uniform(0.5, 15)\n",
    "        \n",
    "        # Trip start time (hourly)\n",
    "        trip_time = date + timedelta(hours=np.random.randint(0,24), minutes=np.random.randint(0,60))\n",
    "        \n",
    "        # Approximate speed im KM/H\n",
    "        speed = distance / np.random.uniform(0.05, 0.5)  # trip duration 3min-30min\n",
    "        \n",
    "        records.append([trip_time, pickup_lat, pickup_lon, dropoff_lat, dropoff_lon, distance, speed])\n",
    "\n",
    "# Create DataFrame\n",
    "taxi_df = pd.DataFrame(records, columns=[\"pickup_datetime\",\"pickup_lat\",\"pickup_lon\",\n",
    "                                         \"dropoff_lat\",\"dropoff_lon\",\"trip_distance\",\"speed\"])\n",
    "\n",
    "# Save to CSV\n",
    "taxi_df.to_csv(\"synthetic_nyc_taxi_gps.csv\", index=False)\n",
    "print(\"Synthetic taxi GPS data created!\")\n"
   ]
